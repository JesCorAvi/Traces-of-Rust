{
  "name": "traces-of-rust",
  "version": "1.0.0",
  "description": "Tactical Horror - Core Defense & Survival",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-packager . \"Traces of Rust\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/dist$\" && node scripts/postbuild-win.cjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "validate:skills": "node scripts/validate-skills.mjs"
  },
  "keywords": [
    "horror",
    "survivor",
    "threejs",
    "steamworks"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "steamworks.js": "^0.4.0"
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-packager": "^17.1.2"
  }
}
